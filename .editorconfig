root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_diagnostic.CA2007.severity = none

# Temporary: Meziantou.Analyzer 3.0.290 (latest) crashes on the Roslyn 5.x compiler
# shipped with the .NET 10 SDK (AD0001 MissingMethodException for
# ITypeSymbol.get_IsClosed, an API removed in Roslyn 5). Disabling the affected
# rule keeps the build green while the rest of the analyzer package stays active.
# Re-enable once upstream ships a Roslyn 5-compatible build.
dotnet_diagnostic.MA0150.severity = none

# Conservative correctness/maintainability baseline.
# Intentionally small: using hygiene, braces, readonly state and
# low-noise modernizations. No broad opinionated ruleset.
dotnet_sort_system_directives_first = true:warning
csharp_using_directive_placement = outside_namespace:warning
csharp_prefer_braces = true:warning
dotnet_style_readonly_field = true:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion

[*.{json,jsonc,yml,yaml,md,ts,tsx,css,html}]
indent_style = space
indent_size = 2

# EF Core migrations are scaffolded tool output; analyzers/formatters skip them.
[src/MtgSoloSports/Persistence/Saves/Migrations/*.cs]
generated_code = true
