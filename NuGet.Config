<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- MSS-033: all direct and transitive packages come from nuget.org.
       <clear /> isolates this repo from user/machine-level feeds (e.g. a
       company "SD" source) so Central Package Management does not raise
       NU1507 (warnings-as-errors) on machines with extra sources configured.
       Do not add private feeds here; if a dependency ever needs another feed,
       switch to explicit package source mapping instead. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
